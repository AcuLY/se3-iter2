# Server
PORT=3001
DATA_DIR=./data
NODE_ENV=development

# LLM-as-a-judge — leave blank to use the deterministic MOCK judge.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# RAGAS bridge — set this if you have a Python with `ragas` installed,
# otherwise the metric returns a synthetic score with a `mock=true` flag.
RAGAS_PYTHON=python
