# LLM provider — OpenAI-compatible. Leave blank to use built-in MOCK mode.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# OpenWeatherMap (https://home.openweathermap.org/api_keys)
OPENWEATHER_API_KEY=

# Amadeus Self-Service (https://developers.amadeus.com/)
AMADEUS_CLIENT_ID=
AMADEUS_CLIENT_SECRET=

# OpenTripMap (https://opentripmap.io/)
OPENTRIPMAP_API_KEY=

# Tavily (https://app.tavily.com/) — optional fallback search
TAVILY_API_KEY=

# Server
TRAVEL_AGENT_PORT=8088
